# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: paper-trade every signal on ai4trade.ai (python ai4trade.py register)
AI4TRADE_TOKEN=

# Optional: News AI (reads headlines every few minutes and can pause entries or close
# positions that big news goes against). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, best judgment) or claude-haiku-5-5 (much cheaper)
NEWS_MODEL=claude-opus-5-5
NEWS_INTERVAL_MIN=10

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
# Extra flags for signals.py, e.g. --paper-usd 5000 --heartbeat-hours 12
SIGNAL_ARGS=

# Pump.fun scanner (test mode). Start it with: docker compose --profile pumpscan up -d
PUMP_INTERVAL_MIN=5
# auto = pump.fun, switching to GeckoTerminal if pump.fun blocks the server
PUMP_SOURCE=auto
# keep off until `python pumpscan.py --report` shows profit after fees over 100+ picks
PUMP_ALERTS=off
